int main() 
    int opcion;
    int cantidadJugadas = 0;
    int numero;
    float dinero;
    float premio;
    int i;

    do {
        printf("\n===== LOTERIA =====\n");
        printf("1. Jugar\n");
        printf("2. Elegir cantidad de jugadas\n");
        printf("3. Salir\n");
        printf("Seleccione una opcion: ");
        scanf("%d", &opcion);

        switch(opcion) {

            case 1:
                if(cantidadJugadas <= 0) {
                    printf("\nPrimero debe elegir la cantidad de jugadas.\n");
                } else {

                    for(i = 1; i <= cantidadJugadas; i++) {

                        do {
                            printf("\nJugada #%d\n", i);
                            printf("Ingrese un numero (1-40): ");
                            scanf("%d", &numero);

                            if(numero < 1 || numero > 40) {
                                printf("Numero invalido. Debe estar entre 1 y 40.\n");
                            }

                        } while(numero < 1 || numero > 40);

                        printf("Ingrese la cantidad de dinero jugada: RD$ ");
                        scanf("%f", &dinero);

                        premio = dinero * 1000;

                        printf("Numero jugado: %d\n", numero);
                        printf("Dinero apostado: RD$ %.2f\n", dinero);
                        printf("Premio potencial: RD$ %.2f\n", premio);
                    }
                }
                break;

            case 2:
                printf("\nIngrese la cantidad de jugadas: ");
                scanf("%d", &cantidadJugadas);

                if(cantidadJugadas <= 0) {
                    printf("La cantidad de jugadas debe ser mayor que cero.\n");
                    cantidadJugadas = 0;
                }
                break;

            case 3:
                printf("\nGracias por usar el sistema de loteria.\n");
                break;

            default:
                printf("\nOpcion no valida.\n");
        }

    } while(opcion != 3);

    return 0;
